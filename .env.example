# Copy to `.env` for local dev. NEVER commit `.env` — it's gitignored.
#
# These same values must be configured in GitHub for the deploy workflow:
#   - Settings → Secrets and variables → Actions → Variables tab:
#       AWS_REGION, S3_BUCKET, CODEDEPLOY_APP, CODEDEPLOY_GROUP
#   - Settings → Secrets and variables → Actions → Secrets tab:
#       AWS_ROLE_ARN

# AWS region where your infra lives
AWS_REGION=eu-west-1

# S3 bucket that stores CodeDeploy bundles (must be globally unique)
S3_BUCKET=flask-demo-artifacts-cnm-9472

# CodeDeploy application + deployment group names
CODEDEPLOY_APP=flask-demo-app
CODEDEPLOY_GROUP=flask-demo-dg

# IAM role the GitHub Actions runner assumes via OIDC.
# Treat as a secret because it contains your AWS account ID.
AWS_ROLE_ARN=arn:aws:iam::003100375237:role/GitHubActionsDeployRole
